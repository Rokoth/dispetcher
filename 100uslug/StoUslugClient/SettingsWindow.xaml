<Window x:Class="StoUslugClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoUslugClient"
        mc:Ignorable="d"
        Title="Настройки" Height="450" Width="350" ResizeMode="NoResize">
    <Grid>
        <Label Content="Сервер" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="10,65,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top"/>
        
        <TextBox x:Name="ServerTextBox" HorizontalAlignment="Left" Margin="75,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="265" Height="26"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="75,65,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="265" Height="29"/>
        <PasswordBox x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="75,110,0,0" VerticalAlignment="Top" Width="265" Height="26"/>

    </Grid>
</Window>
