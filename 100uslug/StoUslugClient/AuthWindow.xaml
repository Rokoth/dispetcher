<Window x:Class="StoUslugClient.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoUslugClient"
        mc:Ignorable="d"
        Title="Авторизация" Height="250" Width="400">
    <Grid>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="21,32,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="84,32,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="306" Height="26"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="21,79,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="PasswordTextBox" HorizontalAlignment="Left" Margin="84,79,0,0" VerticalAlignment="Top" Width="306" Height="31"/>

    </Grid>
</Window>
